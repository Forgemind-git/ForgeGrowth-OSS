# ─── Forge Growth — environment ──────────────────────────────────────────────
# Copy to `.env` and fill in. `docker compose up` reads this file directly.
#
#   cp .env.example .env
#   ./scripts/generate-secrets.sh >> .env     # fills the three secrets below
#
# Nothing here is optional-but-secret: the three SECRETS block entries must be
# set or the stack refuses to start in production.

# ─── Secrets (generate these — never reuse the examples) ─────────────────────
# openssl rand -base64 48
FORGECRM_JWT_SECRET=
# Exactly 32 bytes, hex-encoded: openssl rand -hex 32
# ⚠ Encrypts Meta tokens, Google OAuth tokens and gateway credentials at rest.
#   LOSING THIS MAKES EVERY STORED CREDENTIAL UNRECOVERABLE. Back it up.
#   CHANGING IT does not re-encrypt anything — existing rows become garbage.
FORGECRM_ENCRYPTION_KEY=
# Any random string; you paste the same value into Meta's webhook setup.
META_WEBHOOK_VERIFY_TOKEN=

# ─── Database ────────────────────────────────────────────────────────────────
# With the bundled compose stack, leave the host as the service name.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=forgegrowth
POSTGRES_USER=forgegrowth
POSTGRES_PASSWORD=change-me
POSTGRES_SSL=false
# Alternatively point at an existing server and ignore the five vars above:
# SUPABASE_DATABASE_URL=postgres://user:pass@host:5432/dbname

# ─── Redis (BullMQ queues) ───────────────────────────────────────────────────
# ⚠ Queue NAMES are hardcoded. If two deployments share one Redis server they
#   must use different database indexes (…/0, …/1) or they will consume each
#   other's outbound WhatsApp jobs.
REDIS_URL=redis://redis:6379/0

# ─── Object storage (media library) ──────────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=forgegrowth
MINIO_ROOT_PASSWORD=change-me-too
# ⚠ MINIO_ACCESS_KEY / MINIO_SECRET_KEY OVERRIDE the two above for the backend
#   client only — the MinIO server itself is always started with the ROOT pair.
#   Setting one and not the other means the server and the client disagree, and
#   every upload fails with SignatureDoesNotMatch and no explanation. Leave both
#   commented unless you are pointing at an external S3/MinIO with its own creds.
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
FORGECRM_MEDIA_BUCKET=forgegrowth-media

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3013
NODE_ENV=production
# Public origin. Must match how the browser reaches you, or CORS rejects the
# request — which surfaces as a generic 500, not a CORS message.
CORS_ORIGIN=http://localhost:8080
FORGECRM_DOMAIN=localhost
# Host port the UI is published on by the bundled compose file.
WEB_PORT=8080

# First-run admin. If the password is omitted a strong one is generated and
# printed ONCE to the backend log.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# ─── Meta WhatsApp Cloud API ─────────────────────────────────────────────────
META_API_VERSION=v21.0
# Per-account tokens are added in the UI (encrypted at rest). This global one is
# only a fallback for single-account setups.
META_ACCESS_TOKEN=
# WABAs you own but have not registered as full accounts (comma-separated).
# Inbound from an unregistered WABA is dropped — Meta delivers a WABA's webhooks
# to every app subscribed to it, including other tenants'.
WEBHOOK_EXTRA_ALLOWED_WABAS=

# ─── AI providers (optional — needed for AI agents) ──────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Optional: external agent bridge ─────────────────────────────────────────
# Forward one number's traffic to an external agent instead of the inbox.
# Leave unset to disable.
FORGETASK_PHONE_NUMBER_ID=
FORGETASK_FROM_NUMBER=
FORGETASK_AGENT_WEBHOOK_URL=
FORGETASK_AGENT_API_KEY=

# ─── Tuning (safe defaults; override only if you know why) ───────────────────
# SEND_RATE_MAX=60                       # outbound msgs per SEND_RATE_DURATION_MS
# SEND_RATE_DURATION_MS=1000
# SEND_QUEUE_CONCURRENCY=5
# MEDIA_RETENTION_DAYS=180
# WEBHOOK_RETENTION_DAYS=30
# TEMPLATE_SYNC_INTERVAL_MS=600000       # 10 min
# META_ADS_SYNC_INTERVAL_MS=21600000     # 6 h
# RAZORPAY_LEDGER_SYNC_INTERVAL_MS=3600000   # 1 h
# MCP_BODY_LIMIT=30mb                    # inline base64 uploads over MCP
# BROADCAST_SCHEDULER_INTERVAL_MS=60000  # 1 min — picks up scheduled broadcasts
# STATUS_RECONCILE_INTERVAL_MS=900000    # 15 min — reconciles stuck send statuses
# FUNNEL_TAG_SWEEP_INTERVAL_MS=300000    # 5 min — mirrors lead stage onto contact tags
#
# The two sweepers below run at 60s rather than the 5-minute cadence used
# elsewhere, because both make a promise to a customer about timing: a
# "follow up in 1 hour" step and a "pay in the next 10 minutes" chase are only
# credible if they fire near the minute promised. Both idle on one indexed
# query when there is nothing outstanding.
# FOLLOW_UP_SWEEP_INTERVAL_MS=60000      # 1 min — enrollment cursor + due follow-up steps
# PAYMENT_WATCH_INTERVAL_MS=60000        # 1 min — confirm / chase / time out payment links
# PRICING_SYNC_INTERVAL_MS=21600000      # 6 h — pulls Meta pricing_analytics for message costs
