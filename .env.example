# ─── Forge Growth — environment ──────────────────────────────────────────────
# Copy to `.env` and fill in. `docker compose up` reads this file directly.
#
# You should not have to touch this file at all: the installer creates `.env`
# from it, generates every secret below and derives the address settings from
# the one question it asks. This is the reference for what it wrote, and the
# place to change something afterwards.
#
# By hand instead:
#
#   cp .env.example .env
#   ./scripts/generate-secrets.sh >> .env     # fills in the five empty values
#
# Five entries below ship EMPTY rather than with a placeholder, and that is
# deliberate — see POSTGRES_PASSWORD. The stack refuses to start without them
# in production rather than falling back to something that works everywhere.

# ─── Secrets (generate these — never reuse the examples) ─────────────────────
# openssl rand -base64 48
FORGECRM_JWT_SECRET=
# Exactly 32 bytes, hex-encoded: openssl rand -hex 32
# ⚠ Encrypts Meta tokens, Google OAuth tokens and gateway credentials at rest.
#   LOSING THIS MAKES EVERY STORED CREDENTIAL UNRECOVERABLE. Back it up.
#   CHANGING IT does not re-encrypt anything — existing rows become garbage.
FORGECRM_ENCRYPTION_KEY=
# Any random string; you paste the same value into Meta's webhook setup.
META_WEBHOOK_VERIFY_TOKEN=

# ─── Database ────────────────────────────────────────────────────────────────
# With the bundled compose stack, leave the host as the service name.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=forgegrowth
POSTGRES_USER=forgegrowth
# Left empty on purpose. Both compose files declare this as
# ${POSTGRES_PASSWORD:?…}, which only fires when the value is unset OR EMPTY —
# so a placeholder here would satisfy the guard and hand every by-hand install
# the same database password. The installer fills it in; see the note above.
POSTGRES_PASSWORD=
POSTGRES_SSL=false
# Alternatively point at an existing server and ignore the five vars above:
# SUPABASE_DATABASE_URL=postgres://user:pass@host:5432/dbname

# ─── Redis (BullMQ queues) ───────────────────────────────────────────────────
# ⚠ Queue NAMES are hardcoded. If two deployments share one Redis server they
#   must use different database indexes (…/0, …/1) or they will consume each
#   other's outbound WhatsApp jobs.
REDIS_URL=redis://redis:6379/0

# ─── Object storage (media library) ──────────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=forgegrowth
# Empty for the same reason as POSTGRES_PASSWORD above.
MINIO_ROOT_PASSWORD=
# ⚠ MINIO_ACCESS_KEY / MINIO_SECRET_KEY OVERRIDE the two above for the backend
#   client only — the MinIO server itself is always started with the ROOT pair.
#   Setting one and not the other means the server and the client disagree, and
#   every upload fails with SignatureDoesNotMatch and no explanation. Leave both
#   commented unless you are pointing at an external S3/MinIO with its own creds.
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
FORGECRM_MEDIA_BUCKET=forgegrowth-media

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3013
NODE_ENV=production
# Public origin. Must match how the browser reaches you, or CORS rejects the
# request — which surfaces as a generic 500, not a CORS message.
CORS_ORIGIN=http://localhost:8080
FORGECRM_DOMAIN=localhost
# Whether the login cookie is marked `Secure`. Derived automatically from
# TLS_DOMAIN / CORS_ORIGIN and normally left blank. Set it to true only when TLS
# is terminated by a proxy this stack does not manage, so the scheme above still
# reads http. Setting it true on an install actually served over http logs
# everyone out: the browser discards a Secure cookie sent to an http:// origin
# without reporting anything, so login returns 200 and the next request is 401.
COOKIE_SECURE=
# Host port the UI is published on by the bundled compose file.
WEB_PORT=8080

# ─── Memory ceilings ─────────────────────────────────────────────────────────
# Roughly 1.5 GB in total, so this can share a server with other things instead
# of expanding until the machine starts swapping. These are a floor that works,
# not a recommendation: on a box of your own, raise them.
#
# A container that hits its ceiling is killed and restarted. So if something
# restarts over and over after you lower one of these, the ceiling is the cause
# — `docker compose ps` shows the restart count.
#
# Raise BACKEND first: its appetite grows with the number of conversations being
# handled at once and with media being downloaded. A busy install wants 1g.
BACKEND_MEM_LIMIT=512m
# Keep POSTGRES comfortably above shared_buffers (128m by default). Postgres
# does not check that its own settings fit inside the ceiling you give it.
POSTGRES_MEM_LIMIT=512m
MINIO_MEM_LIMIT=256m
REDIS_MEM_LIMIT=128m
# nginx serving static files. It does not need more.
WEB_MEM_LIMIT=64m
# Only used when HTTPS is on (see below).
CADDY_MEM_LIMIT=64m

# ─── HTTPS (optional) ────────────────────────────────────────────────────────
# Set by `./scripts/install.sh --domain crm.example.com`; you can also fill
# these in by hand. All four belong together — the profile is what starts the
# bundled Caddy, and Caddy is what obtains and renews the certificate.
#
#   COMPOSE_PROFILES=tls          turns the caddy service on. Read from this
#                                 file by compose itself, so a later plain
#                                 `docker compose up -d` keeps HTTPS running.
#   TLS_DOMAIN=crm.example.com    the certificate is issued for this name, so
#                                 its DNS must already point at this machine
#                                 and ports 80 and 443 must be free.
#   TLS_EMAIL=you@example.com     expiry warnings from Let's Encrypt. The word
#                                 "internal" self-signs instead — for a
#                                 hostname with no public DNS, where the
#                                 challenge could never succeed.
#   WEB_BIND=127.0.0.1            keeps the plain-HTTP port off the network, so
#                                 the site is not also served without a
#                                 certificate.
#
# Leave all four unset to serve plain HTTP on WEB_PORT — correct if you already
# run your own reverse proxy and want to point it here.
COMPOSE_PROFILES=
TLS_DOMAIN=
TLS_EMAIL=
WEB_BIND=0.0.0.0

# ─── Optional: publish routes to a reverse proxy you already run ─────────────
# With both of these set, a domain added in Admin Settings -> Domain is routed
# automatically — no file to paste, no shell. Off unless BOTH are set: a guessed
# directory is either useless or writes into somebody else's proxy, and neither
# failure announces itself.
#
#   TRAEFIK_DYNAMIC_DIR   path INSIDE this container that the proxy also watches
#   PROXY_UPSTREAM        how the proxy reaches this install — the CONTAINER
#                         name, not the compose service name. A service alias is
#                         not unique once two installs share a network, and `web`
#                         would resolve to whichever answered first.
#   PROXY_ROUTES_DIR      the host path behind TRAEFIK_DYNAMIC_DIR, used by the
#                         overlay that mounts it
#
# Generated routes carry priority 1 — the lowest Traefik accepts — so they can
# never take a hostname another site on that proxy already serves. Full setup,
# including the proxy's own flags: docs/reverse-proxy.md
TRAEFIK_DYNAMIC_DIR=
PROXY_UPSTREAM=
PROXY_ROUTES_DIR=

# Whether THIS install owns ports 80/443, decided by install.sh and read by
# Admin Settings -> Domain. `caddy` means a domain added there gets its
# certificate automatically on first visit. `proxy` means something else on this
# server owns those ports, so the domain is accepted immediately but the
# certificate has to come from that proxy. Unset is treated as `proxy`, which is
# the cautious direction: promising a certificate this install cannot obtain is
# the worse of the two mistakes.
TLS_MODE=proxy

# First-run admin. If the password is omitted a strong one is generated and
# printed ONCE to the backend log.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# ─── Meta WhatsApp Cloud API ─────────────────────────────────────────────────
META_API_VERSION=v21.0
# Per-account tokens are added in the UI (encrypted at rest). This global one is
# only a fallback for single-account setups.
META_ACCESS_TOKEN=
# WABAs you own but have not registered as full accounts (comma-separated).
# Inbound from an unregistered WABA is dropped — Meta delivers a WABA's webhooks
# to every app subscribed to it, including other tenants'.
WEBHOOK_EXTRA_ALLOWED_WABAS=

# ─── AI providers (optional — needed for AI agents) ──────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Tuning (safe defaults; override only if you know why) ───────────────────
# SEND_RATE_MAX=60                       # outbound msgs per SEND_RATE_DURATION_MS
# SEND_RATE_DURATION_MS=1000
# SEND_QUEUE_CONCURRENCY=5
# MEDIA_RETENTION_DAYS=180
# WEBHOOK_RETENTION_DAYS=30
# TEMPLATE_SYNC_INTERVAL_MS=600000       # 10 min
# META_ADS_SYNC_INTERVAL_MS=21600000     # 6 h
# RAZORPAY_LEDGER_SYNC_INTERVAL_MS=3600000   # 1 h
# MCP_BODY_LIMIT=30mb                    # inline base64 uploads over MCP
# BROADCAST_SCHEDULER_INTERVAL_MS=60000  # 1 min — picks up scheduled broadcasts
# STATUS_RECONCILE_INTERVAL_MS=900000    # 15 min — reconciles stuck send statuses
# FUNNEL_TAG_SWEEP_INTERVAL_MS=300000    # 5 min — mirrors lead stage onto contact tags
#
# The two sweepers below run at 60s rather than the 5-minute cadence used
# elsewhere, because both make a promise to a customer about timing: a
# "follow up in 1 hour" step and a "pay in the next 10 minutes" chase are only
# credible if they fire near the minute promised. Both idle on one indexed
# query when there is nothing outstanding.
# FOLLOW_UP_SWEEP_INTERVAL_MS=60000      # 1 min — enrollment cursor + due follow-up steps
# PAYMENT_WATCH_INTERVAL_MS=60000        # 1 min — confirm / chase / time out payment links
# PRICING_SYNC_INTERVAL_MS=21600000      # 6 h — pulls Meta pricing_analytics for message costs
